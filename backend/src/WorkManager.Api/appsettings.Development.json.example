{
  "//": "Copy to appsettings.Development.json (git-ignored) and set your local SQL Server connection string.",
  "ConnectionStrings": {
    "//": "Format: Server=<host or host\instance>;Database=WorkManager;Trusted_Connection=True;TrustServerCertificate=True;  e.g. Server=localhost\SQLEXPRESS;...",
    "DefaultConnection": "Server=localhost;Database=WorkManager;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "App": {
    "//": "Optional IANA or Windows timezone id (e.g. Africa/Cairo). Empty = this machine's timezone (FR-042).",
    "TimeZoneId": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  }
}
